# ── LLM (any LangChain init_chat_model string) ─────────────────────────────
BRIEFING_MODEL=anthropic:claude-sonnet-5-5
ANTHROPIC_API_KEY=

# ── Phone ──────────────────────────────────────────────────────────────────
# phoneuse = PhoneUse hosted MCP (https://mcp.phoneuse.com/mcp, pbk_ key)
# mcp  = generic Phone Use MCP server (falls back to ADB for primitives it lacks)
# adb  = direct adb
# mock = canned data, no device
PHONE_BACKEND=mcp
ADB_SERIAL=
# stdio command that launches the Phone Use MCP server...
PHONE_MCP_COMMAND=npx -y @mobilenext/mobile-mcp@latest
# ...or a streamable-http URL instead
PHONE_MCP_URL=
# PhoneUse API key (sent as Authorization: Bearer) and device id from console.phoneuse.com
PHONE_MCP_API_KEY=
PHONE_DEVICE_ID=
# Optional JSON override of primitive → MCP tool mapping, e.g.
# PHONE_MCP_TOOLMAP={"read_sms":{"tool":"get_sms","args":{"count":"{limit}"}}}
PHONE_MCP_TOOLMAP=
EMAIL_APP_PACKAGE=com.google.android.gm
SMS_APP_PACKAGE=com.google.android.apps.messaging

# ── Research / voice ───────────────────────────────────────────────────────
TAVILY_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_multilingual_v2

# ── Delivery ───────────────────────────────────────────────────────────────
DELIVER=audio,sms
USER_PHONE_NUMBER=
PHONE_AUDIO_DIR=/sdcard/Download
# optional real voice call (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# if runs/ is served publicly, the call plays the ElevenLabs mp3 instead of <Say>
PUBLIC_AUDIO_BASE_URL=

# ── Loop ───────────────────────────────────────────────────────────────────
MAX_STEPS=50
MAX_RESEARCH_TOPICS=3
POLL_INTERVAL_S=300
DRY_RUN=0
